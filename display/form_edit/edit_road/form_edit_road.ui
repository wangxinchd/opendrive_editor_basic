 <connections>
  <!-- 道路选择变化 -->
  <connection>
   <sender>comboBox_road</sender>
   <signal>currentIndexChanged(int)</signal>
   <receiver>FormEditRoad</receiver>
   <slot>onRoadSelected(int)</slot>
  </connection>
  
  <!-- 添加控制点 -->
